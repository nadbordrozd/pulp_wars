{
  "name": "pulp-wars",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 6173 --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.engine.json && tsc -p tsconfig.art.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src tests scripts index.html package.json package-lock.json tsconfig.json tsconfig.engine.json tsconfig.art.json vite.config.ts eslint.config.js",
    "format:check": "prettier --check src tests scripts index.html package.json package-lock.json tsconfig.json tsconfig.engine.json tsconfig.art.json vite.config.ts eslint.config.js",
    "art:credentials": "tsx scripts/art/pixellab.ts credentials",
    "art:generate:samples": "tsx scripts/art/pixellab.ts generate --stage sample",
    "art:generate:batch": "tsx scripts/art/pixellab.ts generate --stage batch",
    "art:review-sheets": "tsx scripts/art/pixellab.ts review-sheets",
    "art:chrome-review": "tsx scripts/art/chrome-review.ts",
    "art:hud-readiness-review": "tsx scripts/art/hud-readiness-review.ts",
    "art:archer-review": "tsx scripts/art/archer-projectile-review.ts",
    "art:selection-jump-review": "tsx scripts/art/selection-jump-review.ts",
    "art:candy-terrain-review": "tsx scripts/art/candy-terrain-review.ts",
    "art:ruleset6-terrain-review": "tsx scripts/art/ruleset6-terrain-review.ts",
    "art:road-masks": "tsx scripts/art/road-masks.ts",
    "art:ruleset6-building-road-review": "tsx scripts/art/ruleset6-building-road-review.ts",
    "art:candy-city-review": "tsx scripts/art/candy-city-review.ts",
    "art:footprint-review": "tsx scripts/art/footprint-review.ts",
    "art:unit-scale-review": "tsx scripts/art/unit-scale-review.ts",
    "art:ruleset6-original-unit-review": "tsx scripts/art/ruleset6-original-unit-review.ts",
    "art:ruleset6-candy-unit-review": "tsx scripts/art/ruleset6-candy-unit-review.ts",
    "art:ruleset6-tech-economy-ui-review": "tsx scripts/art/ruleset6-tech-economy-ui-review.ts",
    "art:ruleset6-renderer-review": "tsx scripts/art/ruleset6-renderer-review.ts",
    "art:ruleset6-host-review": "tsx scripts/art/ruleset6-host-review.ts",
    "art:ruleset6-combat-review": "tsx scripts/art/ruleset6-combat-review.ts",
    "art:ruleset6-shell-review": "tsx scripts/art/ruleset6-shell-review.ts",
    "art:square-grid-review": "tsx scripts/art/square-grid-review.ts",
    "art:square-terrain-sample-review": "tsx scripts/art/square-terrain-sample-review.ts",
    "art:square-original-terrain-review": "tsx scripts/art/square-original-terrain-review.ts",
    "art:square-terrain-family-candidate-review": "tsx scripts/art/square-terrain-family-candidate-review.ts",
    "art:rendering-review": "tsx scripts/art/rendering-review.ts",
    "art:validate": "tsx scripts/art/pixellab.ts validate",
    "smoke:browser": "tsx scripts/browser-smoke-v6.ts",
    "smoke:browser:legacy-v5": "tsx scripts/browser-smoke.ts http://localhost:6173/?legacy-v5=1",
    "review:faction-setup": "tsx scripts/browser-smoke.ts --faction-setup-review",
    "validate:poc": "tsx scripts/validate-poc.ts",
    "validate:poc:merge": "tsx scripts/merge-poc-corpus.ts",
    "validate:huge": "tsx scripts/validate-huge-map.ts",
    "validate:large": "tsx scripts/validate-large-map.ts",
    "validate:cooperative": "tsx scripts/validate-cooperative.ts",
    "validate:candy": "tsx scripts/validate-candy.ts",
    "validate:v4-map": "tsx scripts/validate-v4-map.ts",
    "validate:ruleset6-release": "tsx scripts/validate-ruleset6-release.ts",
    "validate:ruleset6-release:refresh": "tsx scripts/validate-ruleset6-release.ts --refresh-normal --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "headless": "tsx src/headless/cli.ts",
    "headless:golden": "vitest run tests/replay/golden-replay.test.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run headless:golden"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
